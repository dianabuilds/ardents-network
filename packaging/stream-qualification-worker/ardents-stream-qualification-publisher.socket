[Unit]
Description=Ardents fixed qualification stream Publisher activation

[Socket]
ListenStream=/run/ardents-stream-qualification/publisher.sock
Accept=yes
SocketUser=ardents-endpoint
SocketGroup=ardents-endpoint
SocketMode=0600
DirectoryMode=0711
MaxConnections=256
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
