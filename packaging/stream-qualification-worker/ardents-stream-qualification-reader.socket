[Unit]
Description=Ardents fixed qualification stream reader activation

[Socket]
ListenStream=/run/ardents-stream-qualification/reader.sock
Accept=yes
SocketUser=ardents-endpoint
SocketGroup=ardents-endpoint
SocketMode=0600
DirectoryMode=0711
MaxConnections=64
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
