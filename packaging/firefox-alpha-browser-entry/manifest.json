{
  "manifest_version": 3,
  "name": "Ardents Alpha Browser Entry",
  "version": "0.1.0",
  "description": "Routes only explicit Ardents alpha HTTP names to the local Endpoint proxy.",
  "permissions": ["proxy", "nativeMessaging", "webRequest", "webRequestBlocking"],
  "host_permissions": ["http://*.ard/*", "https://*.ard/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "alpha-browser-entry@ardents.network",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "154.0"
    }
  }
}
