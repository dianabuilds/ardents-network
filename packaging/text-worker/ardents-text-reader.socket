[Unit]
Description=Ardents fixed text reader activation
PartOf=ardents-endpoint.service

[Socket]
ListenStream=/run/ardents-text/reader.sock
Accept=yes
SocketUser=ardents-endpoint
SocketGroup=ardents-endpoint
SocketMode=0600
DirectoryMode=0711
MaxConnections=64
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
