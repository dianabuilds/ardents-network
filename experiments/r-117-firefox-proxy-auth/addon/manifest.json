{
  "manifest_version": 3,
  "name": "Ardents R-117 proxy authentication fixture",
  "version": "0.1.0",
  "permissions": ["proxy", "nativeMessaging", "webRequest", "webRequestBlocking"],
  "host_permissions": ["http://*.ard/*", "https://*.ard/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "r117-proxy-auth@ardents.invalid",
      "strict_min_version": "154.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
