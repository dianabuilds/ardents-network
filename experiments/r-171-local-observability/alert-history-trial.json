{
    "apiVersion":  1,
    "groups":  [
                   {
                       "folder":  "Local diagnostics",
                       "name":  "Selected history trial",
                       "orgId":  1,
                       "rules":  [
                                     {
                                         "execErrState":  "Error",
                                         "annotations":  {
                                                             "summary":  "Synthetic fixture queue exceeds ten items",
                                                             "__panelId__":  "1",
                                                             "__dashboardUid__":  "synthetic-probe"
                                                         },
                                         "data":  [
                                                      {
                                                          "datasourceUid":  "prometheus",
                                                          "model":  {
                                                                        "intervalMs":  2000,
                                                                        "maxDataPoints":  100,
                                                                        "refId":  "A",
                                                                        "expr":  "diagnostic_fixture_queue_items \u003e bool 10",
                                                                        "instant":  true,
                                                                        "range":  false
                                                                    },
                                                          "relativeTimeRange":  {
                                                                                    "to":  0,
                                                                                    "from":  60
                                                                                },
                                                          "refId":  "A"
                                                      },
                                                      {
                                                          "datasourceUid":  "__expr__",
                                                          "model":  {
                                                                        "datasource":  {
                                                                                           "type":  "__expr__",
                                                                                           "uid":  "__expr__"
                                                                                       },
                                                                        "refId":  "B",
                                                                        "type":  "math",
                                                                        "expression":  "$A \u003e 0"
                                                                    },
                                                          "relativeTimeRange":  {
                                                                                    "to":  0,
                                                                                    "from":  0
                                                                                },
                                                          "refId":  "B"
                                                      }
                                                  ],
                                         "labels":  {
                                                        "severity":  "warning",
                                                        "scope":  "synthetic_fixture"
                                                    },
                                         "noDataState":  "NoData",
                                         "condition":  "B",
                                         "title":  "FixtureQueuePressure",
                                         "uid":  "fixture-history",
                                         "for":  "10s"
                                     }
                                 ],
                       "interval":  "10s"
                   }
               ]
}