logging {
  level = "warn"
}
loki.source.file "fixture" {
  targets = [{ __path__ = "/fixture/events.ndjson", job = "fixture" }]
  forward_to = [loki.process.fixture.receiver]
  on_positions_file_error = "skip"
  file_match {
    enabled = true
    sync_period = "1s"
  }
}
loki.process "fixture" {
  stage.json {
    expressions = { event_time = "at" }
    drop_malformed = true
  }
  stage.timestamp {
    source = "event_time"
    format = "RFC3339Nano"
    action_on_failure = "skip"
  }
  stage.label_drop {
    values = ["filename"]
  }
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = "https://loki:3100/loki/api/v1/push"
    tls_config {
      ca_file = "/certs/ca.crt"
      cert_file = "/certs/client.crt"
      key_file = "/certs/client.key"
      server_name = "loki"
    }
  }
}