package quic

import (
	"bytes"
	"fmt"
	"net"
	"net/netip"
	"testing"
	"time"

	"github.com/qoke/mp-quic-go/internal/ackhandler"
	"github.com/qoke/mp-quic-go/internal/monotime"
	"github.com/qoke/mp-quic-go/internal/protocol"
	"github.com/qoke/mp-quic-go/internal/utils"
	"github.com/qoke/mp-quic-go/internal/wire"
	"go.uber.org/mock/gomock"
)

func budgetSocket(t *testing.T) *net.UDPConn {
	t.Helper()
	socket, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { socket.Close() })
	return socket
}

func TestArdentsBudgetToSocket(t *testing.T) {
	for _, backend := range []string{"native", "generic"} {
		for _, tc := range []struct{ budget, want int }{{1, 0}, {96, 96}, {300, 300}, {1200, 1200}, {1500, 1200}} {
			t.Run(fmt.Sprintf("%s/%d", backend, tc.budget), func(t *testing.T) {
				source, selected, original := budgetSocket(t), budgetSocket(t), budgetSocket(t)
				var socket net.PacketConn = source
				info := packetInfo{}
				if backend == "generic" {
					socket = struct{ net.PacketConn }{source}
				} else {
					info.addr = netip.MustParseAddr("127.0.0.1")
				}
				raw, err := wrapConn(socket)
				if err != nil {
					t.Fatal(err)
				}
				_, basic := raw.(*basicConn)
				if basic != (backend == "generic") {
					t.Fatalf("unexpected UDP implementation %T", raw)
				}
				ctrl := gomock.NewController(t)
				pkt := newTestPacketPacker(t, ctrl, protocol.PerspectiveServer)
				pkt.sealingManager.EXPECT().Get1RTTSealer().Return(newMockShortHeaderSealer(ctrl), nil)
				pkt.pnManager.EXPECT().PeekPacketNumber(protocol.PathID(0), protocol.Encryption1RTT).Return(protocol.PacketNumber(1), protocol.PacketNumberLen2)
				if tc.want > 0 {
					pkt.pnManager.EXPECT().PopPacketNumber(protocol.PathID(0), protocol.Encryption1RTT).Return(protocol.PacketNumber(1))
				}
				conn := newServerTestConnection(t, ctrl, nil, false, connectionOptHandshakeConfirmed()).conn
				conn.packer = pkt.packer
				conn.sendQueue = newSendQueue(newSendConn(raw, original.LocalAddr(), info, utils.DefaultLogger), nil)
				frames := []ackhandler.Frame{{Frame: &wire.PathResponseFrame{}}}
				err = conn.sendPathProbes(protocol.ParseConnectionID([]byte{1, 2, 3, 4}), frames, selected.LocalAddr(), info, protocol.ByteCount(tc.budget), monotime.Now(), 0)
				if err != nil {
					t.Fatal(err)
				}

				// SendProbe writes synchronously. A marker from the same source
				// delimits each local receive queue, including the zero-output case.
				marker := []byte("r172-end")
				for _, receiver := range []*net.UDPConn{selected, original} {
					if _, err := source.WriteToUDP(marker, receiver.LocalAddr().(*net.UDPAddr)); err != nil {
						t.Fatal(err)
					}
					if err := receiver.SetReadDeadline(time.Now().Add(2 * time.Second)); err != nil {
						t.Fatal(err)
					}
					var buffer [65535]byte
					var sizes []int
					for {
						n, from, err := receiver.ReadFromUDPAddrPort(buffer[:])
						if err != nil {
							t.Fatal(err)
						}
						if from != source.LocalAddr().(*net.UDPAddr).AddrPort() {
							t.Fatalf("unexpected sender %v", from)
						}
						if bytes.Equal(buffer[:n], marker) {
							break
						}
						sizes = append(sizes, n)
					}
					if receiver == selected && tc.want > 0 {
						if len(sizes) != 1 || sizes[0] != tc.want {
							t.Fatalf("selected socket received %v, want [%d]", sizes, tc.want)
						}
					} else if len(sizes) > 0 {
						t.Fatalf("unexpected datagrams %v", sizes)
					}
				}
			})
		}
	}
}
