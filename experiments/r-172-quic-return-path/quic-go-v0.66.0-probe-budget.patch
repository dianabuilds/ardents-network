+
+// The anti-amplification limit (section 8 of RFC 9000) can forbid expanding a path probe to 1200 bytes.
+func TestPackPathProbePacketLimitedSize(t *testing.T) {
+	mockCtrl := gomock.NewController(t)
+	tp := newTestPacketPacker(t, mockCtrl, protocol.PerspectiveServer)
+	tp.sealingManager.EXPECT().Get1RTTSealer().Return(newMockShortHeaderSealer(mockCtrl), nil).AnyTimes()
+	tp.pnManager.EXPECT().PeekPacketNumber(protocol.PacketNumberSpaceAppData).Return(protocol.PacketNumber(1), protocol.PacketNumberLen2).AnyTimes()
+	tp.pnManager.EXPECT().PopPacketNumber(protocol.PacketNumberSpaceAppData).Return(protocol.PacketNumber(1)).AnyTimes()
+	frames := []ackhandler.Frame{{Frame: &wire.PathChallengeFrame{Data: [8]byte{1, 2, 3, 4, 5, 6, 7, 8}}}}
+	connID := protocol.ParseConnectionID([]byte{1, 2, 3, 4})
+
+	// expanded to the maximum size, if that's smaller than 1200 bytes
+	p, buf, err := tp.packer.PackPathProbePacket(connID, frames, 96, protocol.Version1)
+	require.NoError(t, err)
+	require.Len(t, buf.Data, 96)
+	require.Equal(t, protocol.ByteCount(96), p.Length)
+
+	// never expanded beyond 1200 bytes
+	_, buf, err = tp.packer.PackPathProbePacket(connID, frames, 1500, protocol.Version1)
+	require.NoError(t, err)
+	require.Len(t, buf.Data, protocol.MinInitialPacketSize)
+
+	// the frames don't fit
+	_, _, err = tp.packer.PackPathProbePacket(connID, frames, 20, protocol.Version1)
+	require.ErrorIs(t, err, errNothingToPack)
+}
