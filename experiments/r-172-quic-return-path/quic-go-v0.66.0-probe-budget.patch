+// A PATH_RESPONSE to a PATH_CHALLENGE that couldn't be expanded to 1200 bytes only validates the peer's address.
+// The anti-amplification limit (section 8 of RFC 9000) doesn't apply to the address anymore. The path MTU is
+// validated by a second PATH_CHALLENGE, sent in an expanded datagram (section 8.2.1).
+func TestPathManagerAddressValidatedBeforePathMTU(t *testing.T) {
+	connIDs := []protocol.ConnectionID{
+		protocol.ParseConnectionID([]byte{1, 2, 3, 4, 5, 6, 7, 8}),
+		protocol.ParseConnectionID([]byte{2, 3, 4, 5, 6, 7, 8, 9}),
+	}
+	pm := newPathManager(
+		func(id pathID) (protocol.ConnectionID, bool) { return connIDs[id], true },
+		func(id pathID) {},
+		utils.DefaultLogger,
+	)
+	now := monotime.Now()
+	addr := &net.UDPAddr{IP: net.IPv4(1, 2, 3, 4), Port: 1000}
+	pm.GetOrCreatePath(addr, now)
+	require.False(t, pm.AddrValidated(addr))
+
+	connID, frames, shouldSwitch := pm.HandlePacket(addr, now, nil, true)
+	require.Equal(t, connIDs[0], connID)
+	require.Len(t, frames, 1)
+	pc := frames[0].Frame.(*wire.PathChallengeFrame)
+	require.False(t, shouldSwitch)
+
+	// the datagram containing the PATH_CHALLENGE was limited by the anti-amplification limit
+	pm.ChallengeNotExpanded(pc.Data)
+	require.False(t, pm.AddrValidated(addr))
+
+	// the PATH_RESPONSE validates the address, and the next packet triggers the second PATH_CHALLENGE
+	pm.HandlePathResponseFrame(&wire.PathResponseFrame{Data: pc.Data})
+	require.True(t, pm.AddrValidated(addr))
+	connID, frames, shouldSwitch = pm.HandlePacket(addr, now, nil, false)
+	require.Equal(t, connIDs[0], connID)
+	require.Len(t, frames, 1)
+	pc2 := frames[0].Frame.(*wire.PathChallengeFrame)
+	require.NotEqual(t, pc.Data, pc2.Data)
+	require.False(t, shouldSwitch) // the path MTU isn't validated yet
+
+	// a repeated PATH_RESPONSE to the first PATH_CHALLENGE has no effect
+	pm.HandlePathResponseFrame(&wire.PathResponseFrame{Data: pc.Data})
+	_, frames, shouldSwitch = pm.HandlePacket(addr, now, nil, false)
+	require.Empty(t, frames)
+	require.False(t, shouldSwitch)
+
+	// the PATH_RESPONSE to the second PATH_CHALLENGE validates the path
+	pm.HandlePathResponseFrame(&wire.PathResponseFrame{Data: pc2.Data})
+	_, frames, shouldSwitch = pm.HandlePacket(addr, now, nil, true)
+	require.Empty(t, frames)
+	require.True(t, shouldSwitch)
+}
