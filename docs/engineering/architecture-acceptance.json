{
  "version": 1,
  "production_roots": [
    "api",
    "cmd",
    "internal",
    "scripts",
    "sdk/go"
  ],
  "file_budget": {
    "default_max": 12,
    "exceptions": {
      "internal/content": {
        "max": 13,
        "reason": "content commands, inventory, retention, and owner-qualified persistence remain one transactional owner",
        "owner": "ARD-023"
      },
      "internal/daemon": {
        "max": 18,
        "reason": "composition, lifecycle, readiness, and process-level recovery remain colocated until a responsibility-preserving split is approved",
        "owner": "ARD-023"
      },
      "internal/discovery": {
        "max": 13,
        "reason": "runtime discovery lifecycle and trust-aware command ownership remain one package",
        "owner": "ARD-023"
      },
      "internal/identity/access": {
        "max": 24,
        "reason": "authentication, enrollment, grants, recovery, revocation, and durable admission share one security invariant boundary",
        "owner": "ARD-023"
      },
      "internal/network/waku": {
        "max": 13,
        "reason": "the sole Waku adapter keeps carrier lifecycle and supported protocol adapters together",
        "owner": "ARD-023"
      },
      "internal/publication": {
        "max": 13,
        "reason": "publication lifecycle, retry, withdrawal, and privacy failure semantics remain one owner",
        "owner": "ARD-023"
      },
      "internal/transfer": {
        "max": 14,
        "reason": "authenticated transfer protocol, candidate lifecycle, and resumable exchange remain one owner",
        "owner": "ARD-023"
      },
      "internal/workload/docker": {
        "max": 13,
        "reason": "the sole Docker adapter keeps engine transport and execution translation together",
        "owner": "ARD-023"
      },
      "internal/workload/execution": {
        "max": 13,
        "reason": "executor-neutral reconciliation and bounded lifecycle control remain one state-machine owner",
        "owner": "ARD-023"
      }
    }
  },
  "package_documentation": {
    "grandfathered_without_package_comment": {}
  },
  "services": {
    "operator": {
      "proto_roots": [
        "api/ardents/v1"
      ],
      "composition": {
        "ConfigurationService": {
          "path": "internal/localapi/server_base.go",
          "function": "NewPrincipalHandler",
          "mode": "register_argument"
        },
        "ContentService": {
          "path": "internal/localapi/server_base.go",
          "function": "NewPrincipalHandler",
          "mode": "register_argument"
        },
        "DiagnosticsService": {
          "path": "internal/localapi/server_base.go",
          "function": "NewPrincipalHandler",
          "mode": "register_argument"
        },
        "IdentityService": {
          "path": "internal/localapi/identity/handler.go",
          "function": "NewHandler",
          "mode": "returned_handler"
        },
        "NetworkService": {
          "path": "internal/localapi/server_base.go",
          "function": "NewPrincipalHandler",
          "mode": "register_argument"
        },
        "NodeService": {
          "path": "internal/localapi/server_base.go",
          "function": "NewPrincipalHandler",
          "mode": "register_argument"
        },
        "RetentionService": {
          "path": "internal/localapi/server_base.go",
          "function": "NewPrincipalHandler",
          "mode": "register_argument"
        },
        "TransferService": {
          "path": "internal/localapi/server_base.go",
          "function": "NewPrincipalHandler",
          "mode": "register_argument"
        },
        "WorkloadService": {
          "path": "internal/localapi/server_base.go",
          "function": "NewPrincipalHandler",
          "mode": "register_argument"
        }
      }
    },
    "application": {
      "proto_roots": [
        "api/ardents/application/v1"
      ],
      "composition": {
        "ContentService": {
          "path": "internal/applicationapi/content/handler.go",
          "function": "NewHTTPHandler",
          "mode": "returned_handler"
        },
        "DiscoveryService": {
          "path": "internal/applicationapi/discovery/handler.go",
          "function": "NewHTTPHandler",
          "mode": "returned_handler"
        },
        "IdentityService": {
          "path": "internal/applicationapi/principal/handler.go",
          "function": "NewHandler",
          "mode": "returned_handler"
        }
      }
    }
  },
  "agent_tooling": {
    "root": ".agents",
    "allowed_prefixes": [
      ".agents/skills/security-audit/"
    ]
  },
  "private_protocol": {
    "proto": "api/ardents/private/v1/private.proto",
    "generated": "internal/messaging/protocol/private.pb.go",
    "go_package": "ardents/internal/messaging/protocol;messagingprotocol",
    "generator": "scripts/generate-api.ps1",
    "owner": "ARD-028"
  }
}
