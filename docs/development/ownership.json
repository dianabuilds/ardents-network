{
  "schema": "ardents-source-ownership-v1",
  "owners": [
    "network",
    "application-interface-v1",
    "historical-evidence",
    "application-interface-v2",
    "text-application"
  ],
  "rules": [
    {
      "id": "application-interface-v1",
      "owner": "application-interface-v1",
      "include_prefixes": [
        "internal/application/interfacev1/"
      ]
    },
    {
      "id": "historical-evidence",
      "owner": "historical-evidence",
      "include_prefixes": [
        "docs/research/",
        "experiments/",
        "tests/compatibility/"
      ]
    },
    {
      "id": "agent-skills",
      "owner": "network",
      "include_prefixes": [
        ".agents/skills/"
      ]
    },
    {
      "id": "network",
      "owner": "network",
      "include_prefixes": [
        ".githooks/",
        ".github/",
        "cmd/",
        "docs/",
        "internal/",
        "packaging/",
        "scripts/",
        "tests/",
        "tests/e2e/",
        "tests/epochfixture/",
        "packaging/alpha-bundle/",
        "packaging/ubuntu-deb/",
        "tests/qualification/",
        "tests/profiles/"
      ],
      "include_paths": [
        ".dockerignore",
        ".gitattributes",
        ".gitignore",
        "AGENTS.md",
        "CONTEXT.md",
        "CONTRIBUTING.md",
        "go.mod",
        "go.sum",
        "LICENSE",
        "Makefile",
        "README.md"
      ],
      "exclude_prefixes": [
        "docs/research/",
        "experiments/",
        "internal/application/interfacev1/",
        "tests/compatibility/",
        "internal/application/interfacev2/",
        "internal/application/textdocument/",
        "cmd/ardents-text/",
        "packaging/text-worker/",
        "tests/qualification/text-worker-policy/"
      ],
      "exclude_paths": [
        "tests/profiles/text-worker-commands.txt"
      ]
    },
    {
      "id": "application-interface-v2",
      "owner": "application-interface-v2",
      "include_prefixes": [
        "internal/application/interfacev2/"
      ]
    },
    {
      "id": "text-application",
      "owner": "text-application",
      "include_prefixes": [
        "internal/application/textdocument/",
        "cmd/ardents-text/",
        "packaging/text-worker/",
        "tests/qualification/text-worker-policy/"
      ],
      "include_paths": [
        "tests/profiles/text-worker-commands.txt"
      ]
    }
  ],
  "pr_check_mappings": [
    {
      "path_prefix": "packaging/stream-qualification-worker/",
      "race": true,
      "owners": [
        {"package": "cmd/ardents-qualification", "test_pattern": "^Test"},
        {"package": "cmd/ardents-stream-qualification", "test_pattern": "^Test"},
        {"package": "internal/application/streamqualification", "test_pattern": "^Test"}
      ]
    },
    {
      "path_prefix": "tests/qualification/stream-network-two-host/",
      "race": true,
      "owners": [
        {"package": "cmd/ardents-qualification", "test_pattern": "^Test(?:Qualification|ResourceVerdict|Issue60|WholeOwner|FailedNET14V)"},
        {"package": "tests/e2e/node/fixturecommand/netem-relay", "test_pattern": "^Test(?:RelayConfiguration|CopyRelayDirection|QualificationNetworkCells)"},
        {"package": "tests/epochfixture/network", "test_pattern": "^Test"},
        {"package": "tests/qualification/stream-network-two-host/fixturecommand/qualification-network", "test_pattern": "^Test"},
        {"package": "internal/endpoint", "test_pattern": "^Test.*(?:Qualification|Stream)"},
        {"package": "internal/node", "test_pattern": "^Test(?:Closed|Hosting)"}
      ]
    },
    {
      "path_prefix": "tests/qualification/net32-idle-one-host/",
      "race": true,
      "owners": [
        {"package": "cmd/ardents-qualification", "test_pattern": "^Test(?:Qualification|ResourceVerdict|Issue60|WholeOwner|FailedNET14V)"},
        {"package": "internal/endpoint", "test_pattern": "^Test.*(?:Qualification|Stream)"}
      ]
    }
  ],
  "qualification_lanes": [
    {
      "id": "text-worker-network",
      "owner": "network",
      "path": "tests/qualification/text-worker-network"
    },
    {
      "id": "text-worker-recovery",
      "owner": "network",
      "path": "tests/qualification/text-worker-recovery"
    },
    {
      "id": "text-command-network",
      "owner": "network",
      "path": "tests/qualification/text-command-network"
    },
    {
      "id": "text-worker-tree",
      "owner": "network",
      "path": "tests/qualification/text-worker-tree"
    },
    {
      "id": "text-worker-escape",
      "owner": "network",
      "path": "tests/qualification/text-worker-escape"
    },
    {
      "id": "text-worker-lifecycle",
      "owner": "network",
      "path": "tests/qualification/text-worker-lifecycle"
    },
    {
      "id": "text-worker-policy",
      "owner": "text-application",
      "path": "tests/qualification/text-worker-policy"
    },
    {
      "id": "endpoint-portable-ubuntu",
      "owner": "network",
      "path": "tests/qualification/endpoint-portable-ubuntu"
    },
    {
      "id": "endpoint-replacement-ubuntu",
      "owner": "network",
      "path": "tests/qualification/endpoint-replacement-ubuntu"
    },
    {
      "id": "service-credential-response-linux",
      "owner": "network",
      "path": "tests/qualification/service-credential-response-linux"
    },
    {
      "id": "native-rendezvous-host",
      "owner": "network",
      "path": "tests/qualification/native-rendezvous-host"
    },
    {
      "id": "net32-idle-one-host",
      "owner": "network",
      "path": "tests/qualification/net32-idle-one-host"
    },
    {
      "id": "stream-network-two-host",
      "owner": "network",
      "path": "tests/qualification/stream-network-two-host"
    }
  ],
  "artifact_lanes": [
    {
      "id": "network-v3",
      "owner": "network",
      "commands": "tests/profiles/headless-commands.txt",
      "packaging": "packaging/alpha-bundle"
    },
    {
      "id": "text-worker",
      "owner": "text-application",
      "commands": "tests/profiles/text-worker-commands.txt",
      "packaging": "packaging/text-worker"
    }
  ]
}
