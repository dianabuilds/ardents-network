{
  "schema": "ardents-source-ownership-v1",
  "owners": [
    "network",
    "application-interface-v1",
    "historical-evidence"
  ],
  "rules": [
    {
      "id": "application-interface-v1",
      "owner": "application-interface-v1",
      "include_prefixes": ["internal/application/interfacev1/"]
    },
    {
      "id": "historical-evidence",
      "owner": "historical-evidence",
      "include_prefixes": [
        "docs/research/",
        "experiments/",
        "tests/compatibility/"
      ]
    },
    {
      "id": "network",
      "owner": "network",
      "include_prefixes": [
        ".githooks/",
        ".github/",
        "cmd/",
        "docs/",
        "internal/",
        "packaging/",
        "scripts/",
        "tests/",
        "tests/e2e/",
        "tests/epochfixture/",
        "packaging/alpha-bundle/",
        "packaging/ubuntu-deb/",
        "tests/qualification/",
        "tests/profiles/"
      ],
      "include_paths": [
        ".dockerignore",
        ".gitattributes",
        ".gitignore",
        "AGENTS.md",
        "CONTEXT.md",
        "CONTRIBUTING.md",
        "go.mod",
        "go.sum",
        "LICENSE",
        "Makefile",
        "README.md"
      ],
      "exclude_prefixes": [
        "docs/research/",
        "experiments/",
        "internal/application/interfacev1/",
        "tests/compatibility/"
      ],
      "exclude_paths": []
    }
  ],
  "qualification_lanes": [
    {"id": "endpoint-portable-ubuntu", "owner": "network", "path": "tests/qualification/endpoint-portable-ubuntu"},
    {"id": "endpoint-replacement-ubuntu", "owner": "network", "path": "tests/qualification/endpoint-replacement-ubuntu"},
    {"id": "native-rendezvous-multihost", "owner": "network", "path": "tests/qualification/native-rendezvous-multihost"},
    {"id": "native-rendezvous-host", "owner": "network", "path": "tests/qualification/native-rendezvous-host"},
    {"id": "alpha-control-two-endpoints", "owner": "network", "path": "tests/qualification/alpha-control-two-endpoints"}
  ],
  "artifact_lanes": [
    {"id": "network-v3", "owner": "network", "commands": "tests/profiles/headless-commands.txt", "packaging": "packaging/alpha-bundle"}
  ]
}
