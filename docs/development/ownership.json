{
  "schema": "ardents-source-ownership-v1",
  "owners": [
    "network",
    "application-interface-v1",
    "historical-evidence",
    "application-interface-v2",
    "text-application"
  ],
  "rules": [
    {
      "id": "application-interface-v1",
      "owner": "application-interface-v1",
      "include_prefixes": [
        "internal/application/interfacev1/"
      ]
    },
    {
      "id": "historical-evidence",
      "owner": "historical-evidence",
      "include_prefixes": [
        "docs/research/",
        "experiments/",
        "tests/compatibility/"
      ]
    },
    {
      "id": "agent-skills",
      "owner": "network",
      "include_prefixes": [
        ".agents/skills/"
      ]
    },
    {
      "id": "network",
      "owner": "network",
      "include_prefixes": [
        ".githooks/",
        ".github/",
        "cmd/",
        "docs/",
        "internal/",
        "packaging/",
        "scripts/",
        "tests/",
        "tests/e2e/",
        "tests/epochfixture/",
        "packaging/alpha-bundle/",
        "packaging/ubuntu-deb/",
        "tests/qualification/",
        "tests/profiles/"
      ],
      "include_paths": [
        ".dockerignore",
        ".gitattributes",
        ".gitignore",
        "AGENTS.md",
        "CONTEXT.md",
        "CONTRIBUTING.md",
        "go.mod",
        "go.sum",
        "LICENSE",
        "Makefile",
        "README.md"
      ],
      "exclude_prefixes": [
        "docs/research/",
        "experiments/",
        "internal/application/interfacev1/",
        "tests/compatibility/",
        "internal/application/interfacev2/",
        "internal/application/textdocument/",
        "cmd/ardents-text/",
        "packaging/text-worker/",
        "tests/qualification/text-worker-policy/"
      ],
      "exclude_paths": [
        "tests/profiles/text-worker-commands.txt"
      ]
    },
    {
      "id": "application-interface-v2",
      "owner": "application-interface-v2",
      "include_prefixes": [
        "internal/application/interfacev2/"
      ]
    },
    {
      "id": "text-application",
      "owner": "text-application",
      "include_prefixes": [
        "internal/application/textdocument/",
        "cmd/ardents-text/",
        "packaging/text-worker/",
        "tests/qualification/text-worker-policy/"
      ],
      "include_paths": [
        "tests/profiles/text-worker-commands.txt"
      ]
    }
  ],
  "qualification_lanes": [
    {
      "id": "text-worker-network",
      "owner": "network",
      "path": "tests/qualification/text-worker-network"
    },
    {
      "id": "text-worker-tree",
      "owner": "network",
      "path": "tests/qualification/text-worker-tree"
    },
    {
      "id": "text-worker-lifecycle",
      "owner": "network",
      "path": "tests/qualification/text-worker-lifecycle"
    },
    {
      "id": "text-worker-policy",
      "owner": "text-application",
      "path": "tests/qualification/text-worker-policy"
    },
    {
      "id": "endpoint-portable-ubuntu",
      "owner": "network",
      "path": "tests/qualification/endpoint-portable-ubuntu"
    },
    {
      "id": "endpoint-replacement-ubuntu",
      "owner": "network",
      "path": "tests/qualification/endpoint-replacement-ubuntu"
    },
    {
      "id": "service-credential-response-linux",
      "owner": "network",
      "path": "tests/qualification/service-credential-response-linux"
    },
    {
      "id": "native-rendezvous-multihost",
      "owner": "network",
      "path": "tests/qualification/native-rendezvous-multihost"
    },
    {
      "id": "native-rendezvous-host",
      "owner": "network",
      "path": "tests/qualification/native-rendezvous-host"
    },
    {
      "id": "alpha-control-two-endpoints",
      "owner": "network",
      "path": "tests/qualification/alpha-control-two-endpoints"
    }
  ],
  "artifact_lanes": [
    {
      "id": "network-v3",
      "owner": "network",
      "commands": "tests/profiles/headless-commands.txt",
      "packaging": "packaging/alpha-bundle"
    },
    {
      "id": "text-worker",
      "owner": "text-application",
      "commands": "tests/profiles/text-worker-commands.txt",
      "packaging": "packaging/text-worker"
    }
  ]
}
