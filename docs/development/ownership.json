{
  "schema": "ardents-source-ownership-v1",
  "owners": [
    "network",
    "application-administration",
    "historical-evidence",
    "application-connection",
    "text-application"
  ],
  "rules": [
    {
      "id": "application-administration",
      "owner": "application-administration",
      "include_prefixes": [
        "internal/application/administration/"
      ]
    },
    {
      "id": "historical-evidence",
      "owner": "historical-evidence",
      "include_prefixes": [
        "docs/research/",
        "experiments/",
        "tests/compatibility/"
      ]
    },
    {
      "id": "agent-skills",
      "owner": "network",
      "include_paths": [
        "skills-lock.json"
      ],
      "include_prefixes": [
        ".agents/skills/"
      ]
    },
    {
      "id": "network",
      "owner": "network",
      "include_prefixes": [
        ".githooks/",
        ".github/",
        "cmd/",
        "docs/",
        "internal/",
        "packaging/",
        "scripts/",
        "tests/",
        "tests/e2e/",
        "tests/epochfixture/",
        "packaging/alpha-bundle/",
        "packaging/ubuntu-deb/",
        "tests/qualification/",
        "tests/profiles/"
      ],
      "include_paths": [
        ".dockerignore",
        ".gitattributes",
        ".gitignore",
        "AGENTS.md",
        "CONTEXT.md",
        "CONTRIBUTING.md",
        "go.mod",
        "go.sum",
        "LICENSE",
        "Makefile",
        "README.md"
      ],
      "exclude_prefixes": [
        "docs/research/",
        "experiments/",
        "internal/application/administration/",
        "tests/compatibility/",
        "internal/application/connection/",
        "internal/application/document/",
        "packaging/document-worker/",
        "tests/qualification/document-worker-policy/"
      ],
      "exclude_paths": [
        "tests/profiles/document-worker-commands.txt"
      ]
    },
    {
      "id": "application-connection",
      "owner": "application-connection",
      "include_prefixes": [
        "internal/application/connection/"
      ]
    },
    {
      "id": "text-application",
      "owner": "text-application",
      "include_prefixes": [
        "internal/application/document/",
        "packaging/document-worker/",
        "tests/qualification/document-worker-policy/"
      ],
      "include_paths": [
        "tests/profiles/document-worker-commands.txt"
      ]
    }
  ],
  "pr_check_mappings": [
    {
      "path_prefix": "scripts/installation/build-forwarding-candidate.py",
      "race": false,
      "owners": [
        {"package": "internal/architecture", "test_pattern": "^TestForwardingBuildRecordsAndSourceManifestRules$"}
      ]
    },
    {
      "path_prefix": "scripts/diagnostics/",
      "race": true,
      "owners": [
        { "package": "internal/architecture", "test_pattern": "^TestLocalDiagnosticsCollector$" },
        { "package": "internal/diagnostics/process", "test_pattern": "^Test" }
      ]
    },
    {
      "path_prefix": "packaging/stream-qualification-worker/",
      "race": true,
      "owners": [
        {"package": "tests/qualification/worker-lifecycle/stream-worker", "test_pattern": "^Test"},
        {"package": "internal/application/streamqualification", "test_pattern": "^Test"}
      ]
    }
  ],
    "qualification_lanes": [
      {
        "id": "publication-timing",
        "owner": "network",
        "path": "tests/qualification/publication-timing"
      },
      {
        "id": "execution-recovery",
        "owner": "network",
        "path": "tests/qualification/execution-recovery"
      },
      {
        "id": "execution-escape",
        "owner": "network",
        "path": "tests/qualification/execution-escape"
      },
      {
        "id": "execution-tree",
        "owner": "network",
        "path": "tests/qualification/execution-tree"
      },
    {
      "id": "installation-startup-manager",
      "owner": "network",
      "path": "tests/qualification/installation-startup-manager"
    },
    {
      "id": "protected-installation",
      "owner": "network",
      "path": "tests/qualification/protected-installation"
    },
    {
      "id": "text-worker-network",
      "owner": "network",
      "path": "tests/qualification/document-worker-network"
    },
    {
      "id": "text-worker-lifecycle",
      "owner": "network",
      "path": "tests/qualification/worker-lifecycle"
    },
    {
      "id": "text-worker-policy",
      "owner": "text-application",
      "path": "tests/qualification/document-worker-policy"
    },
    {
      "id": "service-credential-response-linux",
      "owner": "network",
      "path": "tests/qualification/service-credential-response-linux"
    }
  ],
  "artifact_lanes": [
    {
      "id": "network-v3",
      "owner": "network",
      "commands": "tests/profiles/headless-commands.txt",
      "packaging": "packaging/alpha-bundle"
    },
    {
      "id": "text-worker",
      "owner": "text-application",
      "commands": "tests/profiles/document-worker-commands.txt",
      "packaging": "packaging/document-worker"
    }
  ]
}
